# Copy to .env.local and fill in once a real Sanity project exists.
# Find these in sanity.io/manage after creating the project (Step 0 of the
# build plan). Until then, the Studio at /studio runs on placeholders and
# won't connect to real data — see src/sanity/env.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
